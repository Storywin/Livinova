generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Partner {
  id            String               @id @default(uuid())
  name          String
  email         String               @unique
  phone         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subscriptions ErpSubscription[]
  licenseQuotas PartnerLicenseQuota?
  pricingPlans  PricingPlan[]
  tenants       Tenant[]
}

model Tenant {
  id                 String                 @id @default(uuid())
  partnerId          String?
  name               String
  slug               String                 @unique
  status             SubscriptionStatus     @default(trial)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  accounts           ErpAccount[]
  customers          ErpCustomer[]
  leads              ErpLead[]
  leadActivities     ErpLeadActivity[]
  vendors            ErpVendor[]
  purchaseOrders     ErpPurchaseOrder[]
  vendorBills        ErpVendorBill[]
  vendorPayments     ErpVendorPayment[]
  employees          ErpEmployee[]
  payrollPeriods     ErpPayrollPeriod[]
  payrollRuns        ErpPayrollRun[]
  payrollSettlements ErpPayrollSettlement[]
  commissionPayouts  ErpCommissionPayout[]
  projects           ErpProject[]
  warehouses         ErpWarehouse[]
  invoices           Invoice[]
  licenses           License[]
  partner            Partner?               @relation(fields: [partnerId], references: [id])
  users              User[]                 @relation("TenantUsers")

  @@index([partnerId])
}

model PricingPlan {
  id           String               @id @default(uuid())
  ownerType    PricingPlanOwnerType
  ownerId      String?
  name         String
  description  String?
  durationDays Int
  price        Decimal              @db.Decimal(18, 2)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  invoices     Invoice[]
  partner      Partner?             @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model PartnerLicenseQuota {
  id         String   @id @default(uuid())
  partnerId  String   @unique
  totalQuota Int
  usedQuota  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  partner    Partner  @relation(fields: [partnerId], references: [id])
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  pricingPlanId String
  amount        Decimal       @db.Decimal(18, 2)
  status        PaymentStatus @default(pending)
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  pricingPlan   PricingPlan   @relation(fields: [pricingPlanId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  payment       Payment?

  @@index([tenantId])
  @@index([status])
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String        @unique
  amount        Decimal       @db.Decimal(18, 2)
  paymentMethod String?
  transactionId String?       @unique
  status        PaymentStatus @default(pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
}

model ErpSubscription {
  id        String             @id @default(uuid())
  partnerId String
  package   String
  status    SubscriptionStatus @default(active)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  partner   Partner            @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

model License {
  id          String        @id @default(uuid())
  userId      String
  tenantId    String
  deviceHash  String?       @unique
  deviceName  String?
  status      LicenseStatus @default(active)
  startDate   DateTime
  endDate     DateTime
  lastLoginAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deviceLogs  DeviceLog[]
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  resets      LicenseReset?

  @@index([userId])
  @@index([tenantId])
}

model DeviceLog {
  id         String   @id @default(uuid())
  licenseId  String
  deviceHash String
  ipAddress  String?
  loginAt    DateTime @default(now())
  status     String
  license    License  @relation(fields: [licenseId], references: [id])

  @@index([licenseId])
}

model LicenseReset {
  id          String    @id @default(uuid())
  licenseId   String    @unique
  resetCount  Int       @default(0)
  lastResetAt DateTime?
  license     License   @relation(fields: [licenseId], references: [id])
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ErpProject {
  id                       String                @id @default(uuid())
  tenantId                 String
  name                     String
  description              String?
  revenueRecognitionMethod ErpRevenueRecognition @default(point_in_time)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  tenant                   Tenant                @relation(fields: [tenantId], references: [id])
  leads                    ErpLead[]
  purchaseOrders           ErpPurchaseOrder[]
  vendorBills              ErpVendorBill[]
  sales                    ErpSales[]
  units                    ErpUnit[]
  journals                 ErpJournal[]

  @@index([tenantId])
}

model ErpUnit {
  id        String     @id @default(uuid())
  projectId String
  unitCode  String
  price     Decimal    @db.Decimal(18, 2)
  status    String     @default("available")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  sales     ErpSales[]
  project   ErpProject @relation(fields: [projectId], references: [id])

  @@unique([projectId, unitCode])
}

model ErpCustomer {
  id        String     @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  leads     ErpLead[]
  sales     ErpSales[]

  @@index([tenantId])
}

model ErpLead {
  id         String            @id @default(uuid())
  tenantId   String
  projectId  String?
  customerId String?
  name       String
  email      String?
  phone      String?
  source     String
  status     ErpLeadStatus     @default(new)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  project    ErpProject?       @relation(fields: [projectId], references: [id])
  customer   ErpCustomer?      @relation(fields: [customerId], references: [id])
  activities ErpLeadActivity[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model ErpLeadActivity {
  id             String              @id @default(uuid())
  tenantId       String
  leadId         String
  type           ErpLeadActivityType @default(note)
  notes          String?
  nextFollowUpAt DateTime?
  createdById    String?
  createdAt      DateTime            @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  lead      ErpLead @relation(fields: [leadId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([tenantId, leadId])
  @@index([tenantId, nextFollowUpAt])
}

model ErpVendor {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  address   String?
  taxId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  purchaseOrders ErpPurchaseOrder[]
  bills          ErpVendorBill[]

  @@index([tenantId])
  @@index([tenantId, name])
}

model ErpPurchaseOrder {
  id          String                 @id @default(uuid())
  tenantId    String
  projectId   String?
  vendorId    String
  poNumber    String
  date        DateTime
  notes       String?
  status      ErpPurchaseOrderStatus @default(draft)
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  project   ErpProject?            @relation(fields: [projectId], references: [id])
  vendor    ErpVendor              @relation(fields: [vendorId], references: [id])
  createdBy User?                  @relation(fields: [createdById], references: [id])
  items     ErpPurchaseOrderItem[]
  bills     ErpVendorBill[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, vendorId])
}

model ErpPurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  description     String
  qty             Decimal @db.Decimal(18, 2)
  unitPrice       Decimal @db.Decimal(18, 2)
  wipAccountCode  String  @default("103.04")

  purchaseOrder ErpPurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

model ErpVendorBill {
  id               String              @id @default(uuid())
  tenantId         String
  projectId        String?
  vendorId         String
  purchaseOrderId  String?
  invoiceNumber    String
  date             DateTime
  dueDate          DateTime?
  currency         String              @default("IDR")
  subtotal         Decimal             @db.Decimal(18, 2)
  taxAmount        Decimal             @default(0) @db.Decimal(18, 2)
  retentionPercent Decimal?            @db.Decimal(5, 2)
  retentionAmount  Decimal             @default(0) @db.Decimal(18, 2)
  total            Decimal             @db.Decimal(18, 2)
  status           ErpVendorBillStatus @default(draft)
  postedAt         DateTime?
  paidAt           DateTime?
  notes            String?
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  project       ErpProject?         @relation(fields: [projectId], references: [id])
  vendor        ErpVendor           @relation(fields: [vendorId], references: [id])
  purchaseOrder ErpPurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  createdBy     User?               @relation(fields: [createdById], references: [id])
  items         ErpVendorBillItem[]
  payments      ErpVendorPayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, vendorId])
  @@index([tenantId, projectId])
}

model ErpVendorBillItem {
  id             String  @id @default(uuid())
  billId         String
  description    String
  amount         Decimal @db.Decimal(18, 2)
  wipAccountCode String  @default("103.04")

  bill ErpVendorBill @relation(fields: [billId], references: [id])

  @@index([billId])
}

model ErpVendorPayment {
  id              String               @id @default(uuid())
  tenantId        String
  billId          String
  date            DateTime
  amount          Decimal              @db.Decimal(18, 2)
  cashAccountCode String               @default("101.02")
  type            ErpVendorPaymentType @default(payment)
  notes           String?
  createdById     String?
  createdAt       DateTime             @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  bill      ErpVendorBill @relation(fields: [billId], references: [id])
  createdBy User?         @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([tenantId, billId])
}

model ErpEmployee {
  id           String            @id @default(uuid())
  tenantId     String
  userId       String?
  employeeNo   String
  name         String
  email        String?
  phone        String?
  department   String?
  position     String?
  status       ErpEmployeeStatus @default(active)
  startDate    DateTime          @default(now())
  endDate      DateTime?
  basicSalary  Decimal           @default(0) @db.Decimal(18, 2)
  allowance    Decimal           @default(0) @db.Decimal(18, 2)
  pph21        Decimal           @default(0) @db.Decimal(18, 2)
  bpjsEmployee Decimal           @default(0) @db.Decimal(18, 2)
  bpjsEmployer Decimal           @default(0) @db.Decimal(18, 2)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  user         User?            @relation(fields: [userId], references: [id])
  payrollLines ErpPayrollLine[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId])
  @@index([tenantId, status])
}

model ErpPayrollPeriod {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  runs   ErpPayrollRun[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ErpPayrollRun {
  id                        String              @id @default(uuid())
  tenantId                  String
  periodId                  String
  status                    ErpPayrollRunStatus @default(draft)
  payrollExpenseAccountCode String              @default("504.01")
  payrollPayableAccountCode String              @default("205.02")
  pph21PayableAccountCode   String              @default("204.03")
  bpjsPayableAccountCode    String              @default("205.03")
  grossTotal                Decimal             @default(0) @db.Decimal(18, 2)
  deductionsTotal           Decimal             @default(0) @db.Decimal(18, 2)
  netTotal                  Decimal             @default(0) @db.Decimal(18, 2)
  postedAt                  DateTime?
  paidAt                    DateTime?
  createdById               String?
  approvedById              String?
  paidById                  String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  period      ErpPayrollPeriod       @relation(fields: [periodId], references: [id])
  createdBy   User?                  @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?                  @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  paidBy      User?                  @relation("PayrollPaidBy", fields: [paidById], references: [id])
  lines       ErpPayrollLine[]
  settlements ErpPayrollSettlement[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, periodId])
}

model ErpPayrollLine {
  id           String  @id @default(uuid())
  payrollRunId String
  employeeId   String
  gross        Decimal @default(0) @db.Decimal(18, 2)
  allowance    Decimal @default(0) @db.Decimal(18, 2)
  pph21        Decimal @default(0) @db.Decimal(18, 2)
  bpjsEmployee Decimal @default(0) @db.Decimal(18, 2)
  bpjsEmployer Decimal @default(0) @db.Decimal(18, 2)
  net          Decimal @default(0) @db.Decimal(18, 2)
  notes        String?

  payrollRun ErpPayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   ErpEmployee   @relation(fields: [employeeId], references: [id])

  @@index([payrollRunId])
  @@index([employeeId])
}

model ErpPayrollSettlement {
  id              String                   @id @default(uuid())
  tenantId        String
  payrollRunId    String
  kind            ErpPayrollSettlementKind
  date            DateTime
  amount          Decimal                  @db.Decimal(18, 2)
  cashAccountCode String                   @default("101.02")
  notes           String?
  createdById     String?
  createdAt       DateTime                 @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  payrollRun ErpPayrollRun @relation(fields: [payrollRunId], references: [id])
  createdBy  User?         @relation("PayrollSettlementCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([tenantId, payrollRunId])
  @@index([tenantId, kind])
}

model ErpCommissionPayout {
  id                 String              @id @default(uuid())
  tenantId           String
  salesId            String?
  userId             String
  amount             Decimal             @db.Decimal(18, 2)
  status             ErpCommissionStatus @default(draft)
  payableAccountCode String              @default("205.05")
  expenseAccountCode String              @default("503.04")
  postedAt           DateTime?
  paidAt             DateTime?
  createdById        String?
  approvedById       String?
  paidById           String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  sales      ErpSales? @relation(fields: [salesId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
  createdBy  User?     @relation("CommissionCreatedBy", fields: [createdById], references: [id])
  approvedBy User?     @relation("CommissionApprovedBy", fields: [approvedById], references: [id])
  paidBy     User?     @relation("CommissionPaidBy", fields: [paidById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@index([tenantId, salesId])
}

model ErpSales {
  id                   String                 @id @default(uuid())
  tenantId             String
  projectId            String
  unitId               String
  customerId           String
  status               ErpSalesStatus         @default(draft)
  totalPrice           Decimal                @db.Decimal(18, 2)
  handoverAt           DateTime?
  recognizedAt         DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  documents            ErpGeneratedDocument[]
  payments             ErpPayment[]
  journals             ErpJournal[]
  customer             ErpCustomer            @relation(fields: [customerId], references: [id])
  project              ErpProject             @relation(fields: [projectId], references: [id])
  unit                 ErpUnit                @relation(fields: [unitId], references: [id])
  erpCommissionPayouts ErpCommissionPayout[]

  @@index([tenantId])
}

model ErpPayment {
  id        String           @id @default(uuid())
  salesId   String
  amount    Decimal          @db.Decimal(18, 2)
  dueDate   DateTime
  paidDate  DateTime?
  status    ErpPaymentStatus @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sales     ErpSales         @relation(fields: [salesId], references: [id])
}

model ErpAccount {
  id        String             @id @default(uuid())
  tenantId  String
  code      String
  name      String
  type      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  details   ErpJournalDetail[]

  @@unique([tenantId, code])
}

model ErpJournal {
  id          String             @id @default(uuid())
  tenantId    String
  projectId   String?
  salesId     String?
  date        DateTime
  description String
  reference   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  details     ErpJournalDetail[]
  project     ErpProject?        @relation(fields: [projectId], references: [id])
  sales       ErpSales?          @relation(fields: [salesId], references: [id])

  @@index([tenantId])
  @@index([tenantId, projectId])
  @@index([tenantId, salesId])
}

model ErpJournalDetail {
  id        String     @id @default(uuid())
  journalId String
  accountId String
  debit     Decimal    @default(0) @db.Decimal(18, 2)
  credit    Decimal    @default(0) @db.Decimal(18, 2)
  account   ErpAccount @relation(fields: [accountId], references: [id])
  journal   ErpJournal @relation(fields: [journalId], references: [id])

  @@index([journalId])
  @@index([accountId])
}

model ErpWarehouse {
  id        String             @id @default(uuid())
  tenantId  String
  name      String
  location  String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  movements ErpStockMovement[]
  tenant    Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ErpMaterial {
  id        String             @id @default(uuid())
  name      String
  unit      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  movements ErpStockMovement[]
}

model ErpStockMovement {
  id          String       @id @default(uuid())
  warehouseId String
  materialId  String
  quantity    Decimal      @db.Decimal(18, 2)
  type        String
  createdAt   DateTime     @default(now())
  material    ErpMaterial  @relation(fields: [materialId], references: [id])
  warehouse   ErpWarehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId])
  @@index([materialId])
}

model ErpDocumentTemplate {
  id                 String                 @id @default(uuid())
  name               String
  content            String
  type               String
  variables          Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  generatedDocuments ErpGeneratedDocument[]
}

model ErpGeneratedDocument {
  id         String              @id @default(uuid())
  templateId String
  salesId    String
  content    String
  status     ErpDocumentStatus   @default(draft)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  sales      ErpSales            @relation(fields: [salesId], references: [id])
  template   ErpDocumentTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId])
  @@index([salesId])
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
}

model User {
  id                     String                 @id @default(uuid())
  email                  String                 @unique
  passwordHash           String
  name                   String?
  phone                  String?
  status                 UserStatus             @default(active)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  tenantId               String?
  auditLogs              AuditLog[]             @relation("AuditActor")
  compareLists           CompareList[]
  developerIds           DeveloperUser[]
  favorites              Favorite[]
  inquiries              Inquiry[]
  leads                  Lead[]
  erpLeadActivities      ErpLeadActivity[]
  erpPurchaseOrders      ErpPurchaseOrder[]
  erpVendorBills         ErpVendorBill[]
  erpVendorPayments      ErpVendorPayment[]
  erpEmployees           ErpEmployee[]
  erpPayrollRunsCreated  ErpPayrollRun[]        @relation("PayrollCreatedBy")
  erpPayrollRunsApproved ErpPayrollRun[]        @relation("PayrollApprovedBy")
  erpPayrollRunsPaid     ErpPayrollRun[]        @relation("PayrollPaidBy")
  erpPayrollSettlements  ErpPayrollSettlement[] @relation("PayrollSettlementCreatedBy")
  erpCommissionCreated   ErpCommissionPayout[]  @relation("CommissionCreatedBy")
  erpCommissionApproved  ErpCommissionPayout[]  @relation("CommissionApprovedBy")
  erpCommissionPaid      ErpCommissionPayout[]  @relation("CommissionPaidBy")
  licenses               License[]
  mortgageSimulations    MortgageSimulation[]
  refresh                RefreshToken[]
  tenant                 Tenant?                @relation("TenantUsers", fields: [tenantId], references: [id])
  roles                  UserRole[]
  verificationReviews    VerificationRecord[]   @relation("VerificationReviewer")
  viewingRequests        ViewingRequest[]
  erpCommissionPayouts   ErpCommissionPayout[]

  @@index([createdAt])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Developer {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  description        String?
  website            String?
  email              String?
  phone              String?
  address            String?
  city               String?
  province           String?
  contactPersonName  String?
  contactPersonEmail String?
  contactPersonPhone String?
  verificationStatus VerificationStatus  @default(pending)
  verificationNotes  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profileTemplate    String              @default("classic")
  companyType        String?
  contactPersonRole  String?
  establishedYear    Int?
  portfolioUrl       String?
  adCampaigns        AdCampaign[]
  documents          DeveloperDocument[]
  members            DeveloperUser[]
  projects           Project[]

  @@index([verificationStatus])
}

model DeveloperUser {
  id          String    @id @default(uuid())
  developerId String
  userId      String
  createdAt   DateTime  @default(now())
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([developerId, userId])
  @@index([userId])
}

model DeveloperDocument {
  id           String                @id @default(uuid())
  developerId  String
  type         DeveloperDocumentType
  status       DocumentStatus        @default(uploaded)
  mediaAssetId String
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  developer    Developer             @relation(fields: [developerId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset            @relation(fields: [mediaAssetId], references: [id])

  @@index([developerId])
  @@index([status])
}

model Project {
  id                 String              @id @default(uuid())
  developerId        String
  name               String
  slug               String              @unique
  description        String?
  status             ProjectStatus       @default(under_development)
  smartReadiness     SmartReadinessLevel @default(none)
  verificationStatus VerificationStatus  @default(pending)
  startingPrice      Decimal?            @db.Decimal(18, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  adCampaigns        AdCampaign[]
  developer          Developer           @relation(fields: [developerId], references: [id], onDelete: Cascade)
  location           ProjectLocation?
  listings           PropertyListing[]
  units              PropertyUnit[]

  @@index([developerId])
  @@index([verificationStatus])
  @@index([status])
}

model ProjectLocation {
  id         String   @id @default(uuid())
  projectId  String   @unique
  address    String?
  city       String?
  area       String?
  province   String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PropertyUnit {
  id             String            @id @default(uuid())
  projectId      String
  title          String
  slug           String
  propertyType   PropertyType
  bedrooms       Int?
  bathrooms      Int?
  buildingSize   Int?
  landSize       Int?
  price          Decimal?          @db.Decimal(18, 2)
  startingPrice  Decimal?          @db.Decimal(18, 2)
  availableUnits Int?              @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  listings       PropertyListing[]
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([propertyType])
}

model PropertyListing {
  id                   String                 @id @default(uuid())
  projectId            String
  unitId               String?
  title                String
  slug                 String                 @unique
  status               ListingStatus          @default(draft)
  verificationStatus   VerificationStatus     @default(pending)
  featured             Boolean                @default(false)
  sponsored            Boolean                @default(false)
  recommended          Boolean                @default(false)
  price                Decimal?               @db.Decimal(18, 2)
  startingPrice        Decimal?               @db.Decimal(18, 2)
  description          String?
  specs                Json?
  smartHomeDetails     Json?
  brochureMediaAssetId String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  adCampaigns          AdCampaign[]
  compareItems         CompareItem[]
  favorites            Favorite[]
  inquiries            Inquiry[]
  leads                Lead[]
  mortgageSimulations  MortgageSimulation[]
  images               PropertyImage[]
  brochureMediaAsset   MediaAsset?            @relation("BrochureAsset", fields: [brochureMediaAssetId], references: [id])
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit                 PropertyUnit?          @relation(fields: [unitId], references: [id])
  ratings              PropertyRating[]
  smartFeatures        PropertySmartFeature[]
  viewingRequests      ViewingRequest[]

  @@index([projectId])
  @@index([status])
  @@index([verificationStatus])
  @@index([featured])
}

model PropertyImage {
  id           String          @id @default(uuid())
  listingId    String
  mediaAssetId String
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  listing      PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset      @relation(fields: [mediaAssetId], references: [id])

  @@index([listingId])
  @@index([sortOrder])
}

model SmartFeature {
  id        String                 @id @default(uuid())
  name      String
  slug      String                 @unique
  category  SmartFeatureCategory
  createdAt DateTime               @default(now())
  listings  PropertySmartFeature[]
}

model PropertySmartFeature {
  listingId      String
  smartFeatureId String
  createdAt      DateTime        @default(now())
  listing        PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  smartFeature   SmartFeature    @relation(fields: [smartFeatureId], references: [id], onDelete: Cascade)

  @@id([listingId, smartFeatureId])
  @@index([smartFeatureId])
}

model VerificationRecord {
  id                 String                          @id @default(uuid())
  entityType         VerificationEntityType
  entityId           String
  reviewerId         String
  outcome            VerificationOutcome
  notes              String?
  createdAt          DateTime                        @default(now())
  checklistResponses VerificationChecklistResponse[]
  reviewer           User                            @relation("VerificationReviewer", fields: [reviewerId], references: [id])

  @@index([entityType, entityId])
  @@index([reviewerId])
}

model VerificationChecklistItem {
  id         String                          @id @default(uuid())
  entityType VerificationEntityType
  key        String
  label      String
  isRequired Boolean                         @default(false)
  isActive   Boolean                         @default(true)
  sortOrder  Int                             @default(0)
  createdAt  DateTime                        @default(now())
  updatedAt  DateTime                        @updatedAt
  responses  VerificationChecklistResponse[]

  @@unique([entityType, key])
  @@index([entityType])
  @@index([isActive])
  @@index([sortOrder])
}

model VerificationChecklistResponse {
  id        String                    @id @default(uuid())
  recordId  String
  itemId    String
  value     Boolean
  notes     String?
  createdAt DateTime                  @default(now())
  item      VerificationChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  record    VerificationRecord        @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, itemId])
  @@index([itemId])
}

model MortgageBank {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  isSharia    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  products    MortgageProduct[]
  simulations MortgageSimulation[]
}

model MortgageProduct {
  id                     String               @id @default(uuid())
  bankId                 String
  name                   String
  slug                   String
  defaultInterestRate    Decimal?             @db.Decimal(6, 3)
  promoInterestRate      Decimal?             @db.Decimal(6, 3)
  fixedPeriodMonths      Int?
  floatingRateAssumption Decimal?             @db.Decimal(6, 3)
  shariaMargin           Decimal?             @db.Decimal(6, 3)
  adminFee               Decimal?             @db.Decimal(18, 2)
  insuranceRate          Decimal?             @db.Decimal(6, 3)
  provisiRate            Decimal?             @db.Decimal(6, 3)
  notaryFeeEstimate      Decimal?             @db.Decimal(18, 2)
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  minTenorMonths         Int?
  notes                  String?
  rateSchedule           Json?
  sourceCheckedAt        DateTime?
  sourceTitle            String?
  sourceUrl              String?
  bank                   MortgageBank         @relation(fields: [bankId], references: [id], onDelete: Cascade)
  simulations            MortgageSimulation[]

  @@unique([bankId, slug])
  @@index([bankId])
  @@index([isActive])
}

model MortgageSimulation {
  id        String           @id @default(uuid())
  userId    String?
  listingId String?
  bankId    String?
  productId String?
  inputs    Json
  results   Json
  createdAt DateTime         @default(now())
  bank      MortgageBank?    @relation(fields: [bankId], references: [id])
  listing   PropertyListing? @relation(fields: [listingId], references: [id])
  product   MortgageProduct? @relation(fields: [productId], references: [id])
  user      User?            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([listingId])
  @@index([createdAt])
}

model Lead {
  id        String          @id @default(uuid())
  userId    String?
  listingId String
  name      String
  email     String?
  phone     String?
  message   String?
  source    LeadSource      @default(web)
  createdAt DateTime        @default(now())
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([createdAt])
}

model Inquiry {
  id        String          @id @default(uuid())
  userId    String?
  listingId String
  name      String
  email     String?
  phone     String?
  message   String?
  createdAt DateTime        @default(now())
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([createdAt])
}

model ViewingRequest {
  id          String               @id @default(uuid())
  listingId   String
  userId      String?
  preferredAt DateTime
  notes       String?
  status      ViewingRequestStatus @default(pending)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  listing     PropertyListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user        User?                @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([status])
}

model AdPackage {
  id           String        @id @default(uuid())
  type         AdPackageType @unique
  name         String
  price        Decimal       @db.Decimal(18, 2)
  durationDays Int
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  campaigns    AdCampaign[]

  @@index([isActive])
}

model AdCampaign {
  id          String           @id @default(uuid())
  adPackageId String
  developerId String
  projectId   String?
  listingId   String?
  status      AdCampaignStatus @default(draft)
  startsAt    DateTime?
  endsAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  adPackage   AdPackage        @relation(fields: [adPackageId], references: [id])
  developer   Developer        @relation(fields: [developerId], references: [id], onDelete: Cascade)
  listing     PropertyListing? @relation(fields: [listingId], references: [id])
  project     Project?         @relation(fields: [projectId], references: [id])

  @@index([developerId])
  @@index([status])
}

model ArticleCategory {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Article {
  id              String           @id @default(uuid())
  categoryId      String?
  title           String
  slug            String           @unique
  excerpt         String?
  content         String
  metaTitle       String?
  metaDescription String?
  authorName      String?
  tags            String[]
  status          ArticleStatus    @default(draft)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  coverImageUrl   String?
  category        ArticleCategory? @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([publishedAt])
}

model MediaAsset {
  id                 String              @id @default(uuid())
  kind               MediaKind
  storageProvider    StorageProvider     @default(s3_compat)
  bucket             String
  key                String
  url                String
  mimeType           String?
  sizeBytes          Int?
  width              Int?
  height             Int?
  createdAt          DateTime            @default(now())
  developerDocuments DeveloperDocument[]
  propertyImages     PropertyImage[]
  brochureListings   PropertyListing[]   @relation("BrochureAsset")

  @@index([kind])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime        @default(now())
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

model CompareList {
  id        String        @id @default(uuid())
  userId    String
  name      String        @default("Bandingkan")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     CompareItem[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CompareItem {
  id            String          @id @default(uuid())
  compareListId String
  listingId     String
  createdAt     DateTime        @default(now())
  compareList   CompareList     @relation(fields: [compareListId], references: [id], onDelete: Cascade)
  listing       PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([compareListId, listingId])
  @@index([listingId])
}

model SiteSettings {
  id          String   @id @default("default")
  socialLinks Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CmsPage {
  id              String     @id @default(uuid())
  slug            String     @unique
  title           String
  content         String?
  status          PageStatus @default(draft)
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImageUrl      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
}

model SeoSettings {
  id                     String   @id @default("default")
  siteName               String   @default("Livinova")
  titleTemplate          String   @default("%s | Livinova")
  defaultMetaDescription String?
  robotsTxt              String?
  sitemapEnabled         Boolean  @default(true)
  googleSiteVerification String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PropertyRating {
  id          String          @id @default(uuid())
  listingId   String
  rating      Int
  name        String?
  comment     String?
  isAnonymous Boolean         @default(false)
  createdAt   DateTime        @default(now())
  listing     PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([createdAt])
}

